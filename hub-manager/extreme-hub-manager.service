[Unit]
Description=Extreme Hub maintenance manager
After=network.target

[Service]
Type=simple
User=extreme-hub-manager
Group=extreme-hub-manager
WorkingDirectory=/opt/extreme-hub-manager
Environment=HUB_MANAGER_ORIGIN=https://hubmanager.extremeiptv.net
Environment=HUB_MANAGER_DB=/var/lib/extreme-hub-manager/manager.sqlite
ExecStart=/opt/extreme-hub-manager/.venv/bin/uvicorn service:create_app --factory --host 127.0.0.1 --port 8766 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/extreme-hub-manager
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
