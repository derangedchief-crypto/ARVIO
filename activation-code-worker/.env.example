# Existing panel SSH and MariaDB settings. The DB must only be reachable via
# this SSH tunnel; never expose the panel database to the internet.
PANEL_SSH_HOST=
PANEL_SSH_PORT=22
PANEL_SSH_USERNAME=
PANEL_SSH_PASSWORD=
PANEL_DB_HOST=127.0.0.1
PANEL_DB_PORT=3306
PANEL_DB_NAME=overcast
PANEL_DB_USERNAME=root
PANEL_DB_PASSWORD=

ACTIVATION_WORKER_LOG_FILE=/var/log/iptv-activation-worker/worker.log
