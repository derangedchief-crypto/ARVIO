[Unit]
Description=IPTV verified payment renewal worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=iptvrenewal
Group=iptvrenewal
WorkingDirectory=/opt/iptv-renewal-worker
EnvironmentFile=/etc/iptv-renewal-worker.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/iptv-renewal-worker/venv/bin/python -m uvicorn main:app --app-dir /opt/iptv-renewal-worker --host 127.0.0.1 --port 19093 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/iptv-renewal-worker
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iptv-renewal-worker

[Install]
WantedBy=multi-user.target
